# RPC endpoint for the EVM network you choose.
RPC_URL=https://your-evm-rpc.example

# Public addresses only. Use a multisig for production ownership.
FACTORY_OWNER_ADDRESS=0x0000000000000000000000000000000000000000
FACTORY_FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# Optional token-creation fee in wei. Set to 0 for free creation.
FACTORY_CREATION_FEE_WEI=0

# Keep deployer credentials in Foundry's encrypted keystore:
# cast wallet import community-token-deployer --interactive
